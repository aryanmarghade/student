DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_profile
# Long random signing secret; required in production.
JWT_SECRET=replace-with-a-long-random-secret
# Allowed browser origin for CORS.
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
NODE_ENV=development
# Gemini API key for function-calling academic assistant.
GEMINI_API_KEY=
# Optional Redis URL for future distributed jobs/rate limiting.
REDIS_URL=
STORAGE_BUCKET=student-profile-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Local MinIO aliases for development. Copy these into STORAGE_* or use the MINIO_* fallback names.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=student-local
MINIO_SECRET_KEY=student-local-secret
