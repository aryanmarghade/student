# ==========================================================
# Vision Academy - Production Environment Configuration
# ==========================================================

# Optional Local AI Configuration (Ollama only — 100% optional, no cloud AI)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# APP_URL: The public canonical URL where this application is hosted.
# Automatically set in Cloud Run or specify for custom domains.
APP_URL=

# DATABASE_URL: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name?sslmode=require
DATABASE_URL=

# JWT_SECRET: Strong secret key for signing and validating session JWT tokens
JWT_SECRET=

# ADMIN_EMAIL: Primary institutional administrator email address
ADMIN_EMAIL=admin@visionacademy.edu

# ADMIN_PASSWORD: Initial password for the primary administrator account
ADMIN_PASSWORD=

# S3 Compatible Object Storage (optional - falls back to local storage)
S3_ENDPOINT=
S3_BUCKET=vision-academy
S3_ACCESS_KEY=
S3_SECRET_KEY=

# GitHub Personal Access Token (optional but recommended)
# Required for contribution count data (GitHub GraphQL API)
# Generate at: https://github.com/settings/tokens (read-only 'user' scope)
# SECURITY: Server-side only — NEVER exposed to frontend or logged
GITHUB_TOKEN=
